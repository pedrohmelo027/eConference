# Só local (padrão 3333 / 0.0.0.0)
PORT=3333
HOST=0.0.0.0

# Origens do front, separadas por vírgula
CORS_ORIGIN=http://localhost:3000

# https://<ref>.supabase.co
SUPABASE_URL=https://seu-projeto.supabase.co

# Opcional: só se o projeto Supabase usar a chave legada HS256
SUPABASE_JWT_SECRET=

# Pooler do Supabase (modo transaction, porta 6543) com o papel econference_api.
# Formato: postgresql://econference_api.<ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:6543/postgres
# Veja README, "Banco de dados". Sem ela, a API sobe e /health mostra banco "nao_configurado".
DATABASE_URL=

# Chave secreta do Supabase (sb_secret_...): Admin API para criar usuários e redefinir senhas (UC02).
# Project Settings → API Keys. Nunca vai para o front. Sem ela, a gestão de usuários responde 503.
SUPABASE_SECRET_KEY=
